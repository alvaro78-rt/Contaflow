{
  "name": "Position",
  "type": "object",
  "rls": {
    "read": false,
    "create": {
      "$and": [
        { "user_condition": { "role": "admin" } },
        { "user_condition": { "role": "user" } }
      ]
    },
    "update": {
      "$and": [
        { "user_condition": { "role": "admin" } },
        { "user_condition": { "role": "user" } }
      ]
    },
    "delete": false
  },
  "properties": {
    "company_id": {
      "type": "string"
    },
    "code": {
      "type": "string",
      "description": "C\u00f3digo \u00fanico do cargo"
    },
    "name": {
      "type": "string",
      "description": "Nome do cargo"
    }
  },
  "required": [
    "code",
    "name"
  ]
}