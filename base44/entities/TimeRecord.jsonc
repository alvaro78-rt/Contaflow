{
  "name": "TimeRecord",
  "type": "object",
  "rls": {
    "read": false,
    "create": {
      "$and": [
        { "user_condition": { "role": "admin" } },
        { "user_condition": { "role": "user" } }
      ]
    },
    "update": {
      "$and": [
        { "user_condition": { "role": "admin" } },
        { "user_condition": { "role": "user" } }
      ]
    },
    "delete": false
  },
  "properties": {
    "company_id": {
      "type": "string"
    },
    "employee_id": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "kind": {
      "type": "string",
      "enum": [
        "entry",
        "break_start",
        "break_end",
        "exit"
      ]
    },
    "original_time": {
      "type": "string",
      "description": "Marca\u00e7\u00e3o original do leitor, nunca alterada"
    },
    "recorded_at": { "type": "string", "description": "Instante UTC do registro gerado pelo servidor" },
    "source": { "type": "string", "description": "Origem do registro (por exemplo, employee_web)" },
    "corrected_time": {
      "type": "string"
    },
    "justification": {
      "type": "string"
    },
    "corrections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "actor_id": { "type": "string" },
          "previous": {
            "type": "string"
          },
          "time": {
            "type": "string"
          },
          "justification": {
            "type": "string"
          },
          "at": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "employee_id",
    "date",
    "kind",
    "original_time"
  ]
}