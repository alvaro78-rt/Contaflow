{
  "name": "Employee",
  "type": "object",
  "rls": {
    "read": false,
    "create": {
      "$and": [
        { "user_condition": { "role": "admin" } },
        { "user_condition": { "role": "user" } }
      ]
    },
    "update": {
      "$and": [
        { "user_condition": { "role": "admin" } },
        { "user_condition": { "role": "user" } }
      ]
    },
    "delete": false
  },
  "properties": {
    "credential_version": { "type": "string" },
    "processing_lock": { "type": "string" },
    "company_id": {
      "type": "string",
      "description": "Empresa (sistema) a que o cadastro pertence"
    },
    "full_name": {
      "type": "string"
    },
    "cpf": {
      "type": "string",
      "description": "CPF somente d\u00edgitos"
    },
    "rg": {
      "type": "string"
    },
    "pis": {
      "type": "string",
      "description": "PIS com 11 d\u00edgitos"
    },
    "photo_url": {
      "type": "string",
      "description": "Foto do funcion\u00e1rio"
    },
    "marital_status": {
      "type": "string"
    },
    "birth_date": {
      "type": "string",
      "format": "date"
    },
    "zip_code": {
      "type": "string",
      "description": "CEP"
    },
    "address": {
      "type": "string",
      "description": "Logradouro"
    },
    "address_number": {
      "type": "string",
      "description": "N\u00famero da casa"
    },
    "address_complement": {
      "type": "string",
      "description": "Complemento"
    },
    "neighborhood": {
      "type": "string",
      "description": "Bairro"
    },
    "state": {
      "type": "string",
      "description": "Estado (UF)"
    },
    "dependents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "birth_date": {
            "type": "string"
          },
          "relationship": {
            "type": "string"
          }
        }
      }
    },
    "admission_date": {
      "type": "string",
      "format": "date"
    },
    "position_id": {
      "type": "string"
    },
    "department": {
      "type": "string",
      "description": "Departamento"
    },
    "contract_type": {
      "type": "string"
    },
    "work_regime": {
      "type": "string"
    },
    "schedule_id": {
      "type": "string"
    },
    "base_salary": {
      "type": "number"
    },
    "weekly_hours": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "ativo",
        "afastado",
        "desligado"
      ],
      "enumColors": [
        "green",
        "yellow",
        "gray"
      ],
      "default": "ativo",
      "description": "Situa\u00e7\u00e3o do funcion\u00e1rio"
    },
    "status_reason": {
      "type": "string",
      "description": "Motivo do afastamento ou desligamento"
    },
    "status_date": {
      "type": "string",
      "format": "date",
      "description": "Data da mudan\u00e7a de situa\u00e7\u00e3o"
    },
    "bank_name": {
      "type": "string"
    },
    "bank_agency": {
      "type": "string"
    },
    "bank_account": {
      "type": "string"
    },
    "pix": {
      "type": "string"
    },
    "username": {
      "type": "string",
      "description": "Nome de usu\u00e1rio"
    },
    "password_hash": {
      "type": "string",
      "description": "Senha criptografada"
    },
    "access_role": {
      "type": "string",
      "enum": [
        "admin",
        "gerente",
        "funcionario",
        "master"
      ],
      "enumColors": [
        "blue",
        "purple",
        "green",
        "gray"
      ],
      "default": "funcionario",
      "description": "Perfil de acesso"
    },
    "terms_accepted": {
      "type": "boolean",
      "description": "Aceite do termo de uso e tratamento de dados"
    },
    "terms_accepted_at": {
      "type": "string",
      "description": "Data e hora do aceite do termo"
    }
  },
  "required": [
    "full_name",
    "cpf"
  ]
}