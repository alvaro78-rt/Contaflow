{
  "name": "Rubric",
  "type": "object",
  "rls": {
    "read": false,
    "create": {
      "$and": [
        { "user_condition": { "role": "admin" } },
        { "user_condition": { "role": "user" } }
      ]
    },
    "update": {
      "$and": [
        { "user_condition": { "role": "admin" } },
        { "user_condition": { "role": "user" } }
      ]
    },
    "delete": false
  },
  "properties": {
    "incidence_reviewed": { "type": "boolean" },
    "company_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "provento",
        "desconto",
        "informativa",
        "redutora"
      ]
    },
    "description": {
      "type": "string"
    },
    "fixed_value": {
      "type": "number",
      "description": "Valor fixo opcional"
    },
    "auto_apply": {
      "type": "boolean",
      "default": false,
      "description": "Aplicar valor fixo automaticamente em toda folha"
    }
  },
  "required": [
    "name",
    "category"
  ]
}