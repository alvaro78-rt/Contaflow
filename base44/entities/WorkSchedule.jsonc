{
  "name": "WorkSchedule",
  "type": "object",
  "rls": {
    "read": false,
    "create": {
      "$and": [
        { "user_condition": { "role": "admin" } },
        { "user_condition": { "role": "user" } }
      ]
    },
    "update": {
      "$and": [
        { "user_condition": { "role": "admin" } },
        { "user_condition": { "role": "user" } }
      ]
    },
    "delete": false
  },
  "properties": {
    "company_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "weekly_hours": {
      "type": "number"
    },
    "work_days": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "0=domingo ... 6=s\u00e1bado"
    },
    "entry_time": {
      "type": "string"
    },
    "exit_time": {
      "type": "string"
    },
    "break_start": {
      "type": "string"
    },
    "break_end": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "weekly_hours",
    "work_days",
    "entry_time",
    "exit_time"
  ]
}