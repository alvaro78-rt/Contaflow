{
  "name": "AuthSession",
  "type": "object",
  "description": "Sess\u00f5es de login por CPF, validadas apenas no servidor",
  "rls": {
    "read": false,
    "create": {
      "$and": [
        { "user_condition": { "role": "admin" } },
        { "user_condition": { "role": "user" } }
      ]
    },
    "update": {
      "$and": [
        { "user_condition": { "role": "admin" } },
        { "user_condition": { "role": "user" } }
      ]
    },
    "delete": false
  },
  "properties": {
    "credential_version": { "type": "string" },
    "token": {
      "type": "string",
      "description": "Token opaco emitido no login"
    },
    "employee_id": {
      "type": "string",
      "description": "Funcion\u00e1rio autenticado"
    },
    "role": {
      "type": "string",
      "description": "Perfil no momento do login"
    },
    "company_id": {
      "type": "string",
      "description": "Empresa escolhida pela conta mestre ao entrar"
    },
    "expires_at": {
      "type": "string",
      "description": "Validade ISO do token"
    }
  },
  "required": [
    "token",
    "employee_id",
    "expires_at"
  ]
}