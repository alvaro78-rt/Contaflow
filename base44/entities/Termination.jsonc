{
  "name": "Termination",
  "type": "object",
  "rls": {
    "read": false,
    "create": {
      "user_condition": {
        "email": "deny-all@invalid.invalid"
      }
    },
    "update": {
      "user_condition": {
        "email": "deny-all@invalid.invalid"
      }
    },
    "delete": false
  },
  "properties": {
    "company_id": {
      "type": "string"
    },
    "employee_id": {
      "type": "string"
    },
    "employee_name": {
      "type": "string"
    },
    "employee_cpf": {
      "type": "string"
    },
    "position_name": {
      "type": "string"
    },
    "department": {
      "type": "string"
    },
    "competence": {
      "type": "string",
      "description": "AAAA-MM do desligamento"
    },
    "termination_date": {
      "type": "string",
      "format": "date"
    },
    "type": {
      "type": "string",
      "enum": [
        "sem_justa_causa",
        "com_justa_causa",
        "pedido",
        "acordo",
        "termino"
      ],
      "description": "Modalidade da rescis\u00e3o"
    },
    "notice": {
      "type": "string",
      "enum": [
        "indenizado",
        "trabalhado",
        "dispensado"
      ],
      "description": "Aviso pr\u00e9vio"
    },
    "notice_days": {
      "type": "number",
      "description": "Dias de aviso pr\u00e9vio (30 + 3 por ano, at\u00e9 90)"
    },
    "notice_value": {
      "type": "number"
    },
    "vencidas_days": {
      "type": "number",
      "description": "Dias de f\u00e9rias vencidas a pagar"
    },
    "notice_months": {
      "type": "number"
    },
    "months_13": {
      "type": "number",
      "description": "Avos de 13\u00ba proporcional"
    },
    "months_vacation": {
      "type": "number",
      "description": "Avos de f\u00e9rias proporcionais"
    },
    "fgts_balance": {
      "type": "number",
      "description": "Saldo de FGTS usado como base da multa"
    },
    "fgts_fine_rate": {
      "type": "number"
    },
    "fgts_fine": {
      "type": "number"
    },
    "earnings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "value": {
            "type": "number"
          }
        }
      }
    },
    "deductions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "value": {
            "type": "number"
          }
        }
      }
    },
    "informatives": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "value": {
            "type": "number"
          }
        }
      }
    },
    "total_earnings": {
      "type": "number"
    },
    "total_deductions": {
      "type": "number"
    },
    "net_salary": {
      "type": "number"
    },
    "calc_memory": {
      "type": "object",
      "properties": {
        "daily": {
          "type": "number"
        },
        "salary": {
          "type": "number"
        },
        "irrf_base": {
          "type": "number"
        },
        "inss_13": {
          "type": "number"
        },
        "irrf_13": {
          "type": "number"
        },
        "years": {
          "type": "number"
        }
      }
    },
    "legal_table_label": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "calculada",
        "registrada"
      ],
      "enumColors": [
        "yellow",
        "green"
      ],
      "default": "calculada"
    },
    "paid_at": {
      "type": "string"
    }
  },
  "required": [
    "employee_id",
    "termination_date"
  ]
}