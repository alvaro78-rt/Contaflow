{
  "name": "LegalTable",
  "type": "object",
  "rls": {
    "read": false,
    "create": {
      "user_condition": {
        "email": "deny-all@invalid.invalid"
      }
    },
    "update": {
      "user_condition": {
        "email": "deny-all@invalid.invalid"
      }
    },
    "delete": false
  },
  "properties": {
    "label": {
      "type": "string",
      "description": "Identifica\u00e7\u00e3o da tabela (ex.: Tabela 2025)"
    },
    "start_competence": {
      "type": "string",
      "description": "Vig\u00eancia inicial da tabela (AAAA-MM)"
    },
    "end_competence": {
      "type": "string",
      "description": "Vig\u00eancia final (AAAA-MM). Vazio = ainda em vigor"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Tabela dispon\u00edvel para uso no c\u00e1lculo"
    },
    "inss_bands": {
      "type": "array",
      "description": "Faixas progressivas do INSS do empregado",
      "items": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "number",
            "description": "Limite superior da faixa (R$)"
          },
          "rate": {
            "type": "number",
            "description": "Al\u00edquota da faixa (0.075 = 7,5%)"
          }
        }
      }
    },
    "irrf_bands": {
      "type": "array",
      "description": "Faixas do IRRF com parcela a deduzir",
      "items": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "number",
            "description": "Limite superior da faixa (R$)"
          },
          "rate": {
            "type": "number",
            "description": "Al\u00edquota da faixa (0.075 = 7,5%)"
          },
          "deduction": {
            "type": "number",
            "description": "Parcela a deduzir (R$)"
          }
        }
      }
    },
    "irrf_dependent_deduction": {
      "type": "number",
      "description": "Dedu\u00e7\u00e3o por dependente (R$)"
    },
    "irrf_simplified_discount": {
      "type": "number",
      "description": "Desconto simplificado mensal (R$)"
    },
    "fgts_rate": {
      "type": "number",
      "description": "Al\u00edquota de FGTS (0.08 = 8%). Aprendiz usa 2%"
    },
    "overtime_rate": {
      "type": "number",
      "description": "Fator da hora extra (1.5 = 50%)"
    },
    "overtime_cap_minutes": {
      "type": "number",
      "description": "Limite di\u00e1rio de horas extras (minutos)"
    },
    "tolerance_minutes": {
      "type": "number",
      "description": "Toler\u00e2ncia de marca\u00e7\u00e3o/atraso (minutos)"
    },
    "absence_divisor": {
      "type": "number",
      "description": "Divisor do desconto de falta (30)"
    },
    "notes": {
      "type": "string",
      "description": "Fonte dos valores e observa\u00e7\u00f5es"
    }
  },
  "required": [
    "label",
    "start_competence"
  ]
}