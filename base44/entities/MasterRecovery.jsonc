{
  "name": "MasterRecovery",
  "type": "object",
  "description": "Auditoria e retomada das substitui\u00e7\u00f5es da conta mestre. Guarda apenas o resumo (hash) da chave usada, nunca a chave.",
  "rls": {
    "read": false,
    "create": {
      "$and": [
        { "user_condition": { "role": "admin" } },
        { "user_condition": { "role": "user" } }
      ]
    },
    "update": {
      "$and": [
        { "user_condition": { "role": "admin" } },
        { "user_condition": { "role": "user" } }
      ]
    },
    "delete": false
  },
  "properties": {
    "key_fingerprint": {
      "type": "string",
      "description": "Hash SHA-256 da chave de recupera\u00e7\u00e3o utilizada (uso \u00fanico)"
    },
    "state": {
      "type": "string",
      "enum": [
        "em_andamento",
        "concluida"
      ],
      "enumColors": [
        "yellow",
        "green"
      ],
      "default": "em_andamento",
      "description": "Permite retomar uma troca interrompida"
    },
    "heartbeat_at": {
      "type": "number",
      "description": "Momento (ms) da \u00faltima tentativa, evita dois cliques simult\u00e2neos"
    },
    "new_master_cpf": {
      "type": "string",
      "description": "CPF do mestre que est\u00e1 sendo criado nesta recupera\u00e7\u00e3o"
    },
    "previous_master_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Contas que perderam o papel de mestre nesta recupera\u00e7\u00e3o"
    },
    "new_master_id": {
      "type": "string",
      "description": "Conta mestre resultante"
    },
    "recovered_at": {
      "type": "string",
      "description": "In\u00edcio da recupera\u00e7\u00e3o"
    },
    "completed_at": {
      "type": "string",
      "description": "Conclus\u00e3o da recupera\u00e7\u00e3o"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "key_fingerprint",
    "recovered_at"
  ]
}